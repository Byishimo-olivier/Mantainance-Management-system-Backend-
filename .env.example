# Cache
CACHE_TTL=3600

# Cloudinary
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# App URLs
CORS_ORIGIN=https://www.example.com
FRONTEND_URL=https://www.example.com
BACKEND_URL=https://api.example.com
RESET_PASSWORD_URL=https://www.example.com/reset-password

# Database
DATABASE_URL="mongodb+srv://username:password@cluster.example.mongodb.net/database?retryWrites=true&w=majority"

# Email / SMTP
EMAIL_SERVICE=cpanel
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=info@example.com
SMTP_AUTH_USER=info@example.com
SMTP_AUTH_PASS=your_cpanel_mailbox_password
EMAIL_PASS=your_cpanel_mailbox_password
EMAIL_FROM_NAME=FixNest
SKIP_MAIL_VERIFY=false

# OpenAI
OPENAI_API_KEY=sk-your_openai_project_api_key
OPENAI_MODEL=gpt-5.5

# Auth / sessions
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_LIFETIME=86400000

# Server
NODE_ENV=development
LOG_LEVEL=info
PORT=7000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
REDIS_URL=redis://localhost:6379

# Paypack
PAYPACK_API_KEY=your_paypack_api_key
PAYPACK_API_URL=https://payments.paypack.rw/api
PAYPACK_CALLBACK_URL=https://api.example.com/api/subscriptions/payments/callback
PAYPACK_CLIENT_ID=your_paypack_client_id
PAYPACK_MERCHANT_ID=your_paypack_merchant_id
PAYPACK_SECRET_KEY=your_paypack_secret_key

# MTN MoMo
MTN_API_BASE_URL=https://sandbox.momodeveloper.mtn.co.rw
MTN_API_KEY=your_mtn_api_key
MTN_API_USER=your_mtn_api_user
MTN_CALLBACK_URL=https://api.example.com/api/subscriptions/payments/mobile-money-callback
MTN_COLLECTION_BASE_URL=https://sandbox.momodeveloper.mtn.co.rw/collection/v1_0
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_TARGET_ENVIRONMENT=sandbox
MTN_PRIMARY_KEY=your_mtn_primary_key
MTN_SECRET_KEY=your_mtn_secret_key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_DEFAULT_COUNTRY_CODE=250

# InTouchPay
INTOUCHPAY_BASE_URL=https://www.intouchpay.co.rw
INTOUCHPAY_USERNAME=your_intouchpay_username
INTOUCHPAY_ACCOUNT_NO=your_intouchpay_account_number
INTOUCHPAY_PARTNER_PASSWORD=your_intouchpay_partner_password
INTOUCHPAY_CALLBACK_URL=https://api.example.com/api/subscriptions/payments/mobile-money-callback

# SSO
SSO_DOMAIN=example.com
SSO_PROVIDER_NAME=Auth0
SSO_AUTHORIZATION_URL=https://example.com/authorize
SSO_TOKEN_URL=https://example.com/oauth/token
SSO_USERINFO_URL=https://example.com/userinfo
SSO_CLIENT_ID=your_sso_client_id
SSO_CLIENT_SECRET=your_sso_client_secret
SSO_SCOPE=openid email profile

# Google SSO
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
GOOGLE_SSO_ALLOWED_DOMAINS=example.com
GOOGLE_SSO_DEFAULT_ROLE=client
GOOGLE_SSO_DEFAULT_COMPANY_NAME=
